jira:
  base_url: "https://imagen-ai.atlassian.net"
  email: "tal.m@imagen-ai.com"
  keychain_service: "aidev-jira-token"   # security add-generic-password -a <email> -s aidev-jira-token -w <token>
  label: "aidev"                         # tag that marks a ticket for automated pickup
  todo_status: "New"                     # matches this Jira instance's board
  in_progress_status: "In Progress"      # status to move ticket to once Claude starts
  review_status: "In Review"             # status to move ticket to once PR is opened
  jql_extra: "project = RND"             # scope pickup to the RND project

repos:
  default: "/Users/talmoskovich/Documents/GitHub/submitter-app-electron"
  app-web-server: "/Users/talmoskovich/Documents/GitHub/app-web-server"
  # add more "REPOKEY: /path/to/repo" here; a ticket can specify which repo via
  # a Jira label like "repo:REPOKEY", otherwise "default" is used.

worktree_root: "/Users/talmoskovich/jira-claude-pipeline/worktrees"

claude:
  dangerously_skip_permissions: true
  review_skill: "/land-pr"               # slash command run in-session after the PR exists (Codex gets the same name as $skill)
  idle_seconds: 20                       # pane must be unchanged this long to be considered "idle"
  idle_poll_interval: 8
  max_wait_seconds: 5400                 # hard cap per postprocess stage (90 min)
  max_running_hours: 6                   # ticket marked FAILED if still RUNNING/STUCK past this
  max_crash_auto_retries: 1              # a crashed process (tmux alive, claude dead; or
                                          # status.json stale 10+ min) auto-relaunches this many
                                          # times (same session, same stage) before giving up and
                                          # marking FAILED for a human — every real crash traced so
                                          # far had a clean, safely-resumable worktree
  context_handoff_threshold: 0.8         # fraction of the model's context window (see
                                          # models.<stage> below for which model — this assumes
                                          # the 1M-token Sonnet/Opus window) at which a RUNNING
                                          # session is proactively retired: asked to write a
                                          # handoff doc, killed, and replaced with a fresh session
                                          # that reads the handoff instead of --resuming a
                                          # conversation close to its limit. This is a distinct,
                                          # earlier trigger than a crash — the session is still
                                          # healthy when this fires, unlike max_crash_auto_retries
                                          # which only reacts after something has already gone
                                          # wrong. Set to 0 or null to disable.
  max_concurrent: 3                      # cap on tickets occupying a Claude Code slot at once
                                          # (RUNNING/STUCK/POSTPROCESS/PR_OPENED); DONE tickets have
                                          # already handed off to human review and don't count —
                                          # extras wait for a slot to free up on the next pickup.py run
  stack_on_review: true                  # if a blocker is sitting at review_status (not merged),
                                          # branch the next ticket off the blocker's own branch
                                          # instead of waiting for it to merge (stacked PRs)
  max_postprocess_attempts: 5            # transient PR-step failures (e.g. slow git commit/push
                                          # in a big repo) retry this many times before FAILED;
                                          # tmux/Claude session stays alive across retries
  auto_review: true                      # apply aidev-self-review at pickup time automatically
                                          # (mirrors qelos-io/aidev's AUTO_REVIEW=true) — set false
                                          # to require manual tagging instead.
  models:                                # per-stage --model override. Every stage below
                                          # is pinned EXPLICITLY, not left null/"account
                                          # default" — the whole point of this block is to
                                          # be immune to a silent account-default change
                                          # (2.1.280 changed the Pro/Team Standard default
                                          # from Sonnet to Opus). Haiku only for the
                                          # approval-verdict stage (simple 3-way
                                          # classification against an explicit rule, not
                                          # open-ended judgment — see SKILL.md).
    implement: "sonnet"
    rework: "sonnet"
    self_review: "sonnet"
    codex_check: "sonnet"
    auto_merge_resolving_conflict: "sonnet"
    auto_merge_fixing_bugbot: "sonnet"
    auto_merge_recheck: "sonnet"
    auto_merge_fixing_ci: "sonnet"
    auto_merge_addressing_approval_feedback: "haiku"
    auto_merge_addressing_pr_feedback: "sonnet"

codex:
  enabled: true
  timeout_seconds: 1800                  # 30 min hard cap on the codex exec subprocess
  sandbox: "workspace-write"             # full permissions; runs the review skill, which fixes and pushes
  min_diff_lines: 30                     # below this many total changed lines, skip Codex
                                          # entirely and rely on the review pass already
                                          # run during self_review — 0 disables this gate
  report_dir: ".claude-code"             # relative to the worktree; matches repo's scratch-doc convention
                                          # the claude.review_skill plugin is installed natively in Codex
                                          # (~/.codex/config.toml plugins."*@imagen-skills", same
                                          # imagen-skills marketplace repo as Claude's plugin cache) — the
                                          # prompt invokes them with Codex's own $skill-name syntax, no
                                          # path resolution needed here

pr:
  open_pr: true
  base_branch: "master"

state_db: "/Users/talmoskovich/jira-claude-pipeline/state/aidev.sqlite3"
log_dir: "/Users/talmoskovich/jira-claude-pipeline/logs"

notifications:
  # Optional. Create at https://api.slack.com/apps -> your app -> Incoming
  # Webhooks -> Activate -> Add New Webhook to Workspace. Leave unset to
  # only get the native macOS notification (always on, no config needed).
  slack_webhook_url: ""
